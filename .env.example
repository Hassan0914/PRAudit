# PRAudit Environment Configuration

# --- Application Settings ---
APP_NAME=PRAudit
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- LLM Provider API Keys ---
# Anthropic Claude API Key (Phase 16)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local LLM Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# --- GitHub Integration Settings (Phase 15) ---
GITHUB_APP_ID=your_github_app_id_here
GITHUB_PRIVATE_KEY_PATH=path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# --- Enterprise Storage & Caching (Phase 20) ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///praudit.db